{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "**/*.html",
    "src/view/world/ego-car.jsx",
    "tests/fixtures"
  ],
  "sortImports": false,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": ["cn", "clsx", "cva"]
  }
}
